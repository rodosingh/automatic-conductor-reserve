# Copy to .env and fill in real values.  chmod 600 .env  — never commit the real file.
# Get each API key from Conductor > profile > API key. Auth header is "<email>:<secret>".
VERIFY_CERTS=false

# --- Coordinator / reader, and the booking identity for your own extra node ---
AMD_EMAIL=you@amd.com
ATS_SECRET=REPLACE_WITH_YOUR_API_KEY

# --- Optional: extra booking identities for book_team.py (one assigned node each) ---
# Only needed if you book on behalf of teammates (see config.yaml team_booking.assignments).
# Add as many CRED_<N>_* pairs as you have identities; N matches the `cred: <N>` in config.
CRED_1_EMAIL=teammate1@amd.com
CRED_1_SECRET=REPLACE_WITH_TEAMMATE1_API_KEY

CRED_2_EMAIL=teammate2@amd.com
CRED_2_SECRET=REPLACE_WITH_TEAMMATE2_API_KEY
